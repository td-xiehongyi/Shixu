{
  "identifier": "vault",
  "description": "Dedicated vault window only; KdbxWeb dispatcher; production Windows admission remains blocked",
  "local": true,
  "permissions": [
    "allow-vault-create",
    "allow-vault-change-master",
    "allow-vault-copy",
    "allow-vault-unlock",
    "allow-vault-list",
    "allow-vault-activity",
    "allow-vault-apply",
    "allow-vault-reveal",
    "allow-vault-lock",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-ack-vault-view"
  ],
  "webviews": [
    "vault"
  ]
}
