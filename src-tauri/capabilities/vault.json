{
  "identifier": "vault",
  "description": "Dedicated vault window only; KdbxWeb dispatcher; Windows isolation remains unavailable",
  "local": true,
  "windows": ["vault"],
  "permissions": [
    "allow-vault-create",
    "allow-vault-change-master",
    "allow-vault-copy",
    "allow-vault-unlock",
    "allow-vault-list",
    "allow-vault-activity",
    "allow-vault-apply",
    "allow-vault-reveal",
    "allow-vault-lock",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
