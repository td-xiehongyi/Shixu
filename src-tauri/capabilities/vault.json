{
  "identifier": "vault",
  "description": "Dedicated vault window only; engine currently unsupported",
  "local": true,
  "windows": ["vault"],
  "permissions": [
    "allow-vault-create",
    "allow-vault-change-master",
    "allow-vault-copy",
    "allow-vault-unlock",
    "allow-vault-list",
    "allow-vault-apply",
    "allow-vault-reveal",
    "allow-vault-lock"
  ]
}
